# Contact (src/sections/Contact.tsx) va Formo (src/sections/Projects.tsx)
# formalari /api/send-telegram serverless funksiyasiga so'rov yuboradi
# (api/send-telegram.js), tokenlar faqat serverda ishlatiladi va brauzerga
# hech qachon yuborilmaydi.
# Bu faylga haqiqiy qiymatlarni yozmang va .env faylini git'ga qo'shmang.
# Production uchun qiymatlarni hosting platformasining (masalan, Vercel)
# Environment Variables bo'limida sozlang.

# Har ikkala forma o'zining alohida Telegram bot/chat juftligini ishlatadi,
# shuning uchun xabarlar aralashmaydi.

# Formo buyurtma formasi uchun (@BotFather orqali yaratilgan bot tokeni)
TELEGRAM_FORMO_BOT_TOKEN=
# Formo xabarlari yuboriladigan Telegram chat/user ID (masalan @userinfobot orqali oling)
TELEGRAM_FORMO_CHAT_ID=

# Contact formasi uchun (alohida bot tokeni)
TELEGRAM_CONTACT_BOT_TOKEN=
# Contact xabarlari yuboriladigan Telegram chat/user ID
TELEGRAM_CONTACT_CHAT_ID=
