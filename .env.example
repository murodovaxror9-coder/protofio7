# Contact formasi (src/sections/Contact.tsx) brauzerdan to'g'ridan-to'g'ri
# Telegram API'ga so'rov yuboradi, shuning uchun VITE_ prefiksi kerak.
# Diqqat: VITE_ prefiksli qiymatlar frontend bundle'ga qo'shiladi va
# brauzerda ochiq ko'rinadi — bu tokenni faqat shaxsiy loyihalarda ishlating.
# bu faylga haqiqiy qiymatlarni yozmang va .env faylini git'ga qo'shmang.

# @BotFather orqali yaratilgan Telegram bot tokeni
VITE_TELEGRAM_BOT_TOKEN=

# Xabarlar yuboriladigan Telegram chat/user ID (masalan @userinfobot orqali oling)
VITE_TELEGRAM_CHAT_ID=
