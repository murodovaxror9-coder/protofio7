# Contact formasi (src/sections/Contact.tsx) /api/send-telegram serverless
# funksiyasiga so'rov yuboradi (api/send-telegram.js), token faqat serverda
# ishlatiladi va brauzerga hech qachon yuborilmaydi.
# Bu faylga haqiqiy qiymatlarni yozmang va .env faylini git'ga qo'shmang.
# Production uchun qiymatlarni hosting platformasining (masalan, Vercel)
# Environment Variables bo'limida sozlang.

# @BotFather orqali yaratilgan Telegram bot tokeni
TELEGRAM_BOT_TOKEN=

# Xabarlar yuboriladigan Telegram chat/user ID (masalan @userinfobot orqali oling)
TELEGRAM_CHAT_ID=
